# Define macros (only works in top-level gitattributes files)
[attr]lfs                           -text filter=lfs diff=lfs merge=lfs
[attr]unity-json                    eol=lf linguist-language=json
[attr]unity-yaml                    eol=lf linguist-language=yaml merge=unityyamlmerge

*                                   text=auto eol=lf
*.cs                                eol=lf diff=csharp
*.md                                eol=lf diff=markdown

# Exclude some files from GitHub stats and diffs
Assets/Plugins/**                   linguist-generated
Assets/TextMesh[[:space:]]Pro/**    linguist-generated
Packages/packages-lock.json         linguist-generated
*.g.cs                              linguist-generated

# Unity shader files
*.cginc                             eol=lf
*.compute                           eol=lf linguist-language=hlsl
*.hlsl                              eol=lf
*.raytrace                          eol=lf linguist-language=hlsl
*.shader                            eol=lf

# Unity JSON files
*.asmdef                            unity-json
*.asmref                            unity-json
*.index                             unity-json
*.inputactions                      unity-json
*.shadergraph                       unity-json
*.shadersubgraph                    unity-json

# Unity UI Toolkit files
*.tss                               eol=lf linguist-language=css diff=css
*.uss                               eol=lf linguist-language=css diff=css
*.uxml                              eol=lf linguist-language=xml linguist-detectable
*.xsd                               eol=lf linguist-generated

# Unity YAML files
