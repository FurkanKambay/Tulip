#header {
    height: 96px;
    background-color: rgb(108, 123, 241);
    position: absolute;
    width: 100%;
}

#header-title {
    -unity-text-align: middle-left;
    font-size: var(--text-big);
    color: rgb(255, 255, 255);
    left: 48px;
    flex-grow: 1;
    align-self: flex-start;
}

.unity-tab__header-underline {
    display: none;
}

.unity-tab__header {
    font-size: var(--text-big);
    height: 64px;
    width: 200px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(34, 38, 42);
    background-image: var(--button-wide-bg-border);
    color: rgb(245, 245, 245);
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 4px;
    margin-left: 4px;
    flex-direction: row;
    justify-content: center;
}

.unity-tab__header:hover {
    background-image: var(--button-wide-bg);
}

.unity-tab__header:checked {
    -unity-background-image-tint-color: rgb(0, 88, 176);
    background-image: var(--button-wide-bg-active);
}

.unity-tab__header:checked:hover {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(0, 82, 163);
}

#header > #key-prompt-container {
    position: absolute;
    width: 720px;
    height: 96px;
    align-self: center;
    flex-direction: row;
    justify-content: space-between;
}

#header .key-prompt {
    align-self: center;
    height: 48px;
    width: 48px;
}

#header #key-prompt-prev {
    background-image: var(--icon-key-q);
}

#header #key-prompt-next {
    background-image: var(--icon-key-e);
}
