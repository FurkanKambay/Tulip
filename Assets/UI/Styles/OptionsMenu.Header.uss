#header {
    height: 96px;
    background-color: rgb(44, 132, 181);
    position: absolute;
    width: 100%;
}

#header-title {
    -unity-text-align: middle-left;
    font-size: var(--text-big);
    color: rgb(255, 255, 255);
    left: 96px;
    flex-grow: 1;
}

.header-button {
    -unity-background-image-tint-color: rgb(34, 38, 42);
    color: rgb(250, 250, 250);
    position: absolute;
    height: 64px;
    width: 64px;
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
    padding-top: 0;
    padding-bottom: 4px;
}

.header-button:checked {
    -unity-background-image-tint-color: rgb(34, 38, 42);
}

.header-button > .unity-toggle__input {
    justify-content: center;
}

.header-button .unity-toggle__checkmark {
    -unity-background-image-tint-color: white;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

#options-toggle:hover {
    -unity-background-image-tint-color: rgb(0, 88, 176);
}

#options-toggle:active {
    -unity-background-image-tint-color: rgb(0, 75, 150);
}

#options-toggle:checked:hover {
    -unity-background-image-tint-color: rgb(171, 0, 0);
}

#options-toggle:checked:active {
    -unity-background-image-tint-color: rgb(145, 0, 0);
}

#options-toggle .unity-toggle__checkmark {
    background-image: var(--icon-settings);
    background-color: rgba(0, 0, 0, 0);
}

#options-toggle:checked .unity-toggle__checkmark {
    background-image: var(--icon-close);
}

#quit-flyout-button {
    right: 0;
}

#quit-flyout-button:hover {
    -unity-background-image-tint-color: rgb(171, 111, 0);
}

#quit-flyout-button:active {
    -unity-background-image-tint-color: rgb(145, 111, 0);
}

#quit-flyout-button:checked:hover {
    -unity-background-image-tint-color: rgb(23, 25, 28);
}

#quit-flyout-button:checked:active {
    -unity-background-image-tint-color: rgb(12, 14, 15);
}

#quit-flyout-button .unity-toggle__checkmark {
    background-image: var(--icon-quit);
}

.quit-button {
    right: 48px;
    width: auto;
    padding-top: 0;
    padding-right: 24px;
    padding-bottom: 4px;
    padding-left: 16px;
}

.quit-button:hover {
    -unity-background-image-tint-color: rgb(171, 0, 0);
}

.quit-button:active {
    -unity-background-image-tint-color: rgb(145, 0, 0);
}

.unity-tab__header-underline {
    display: none;
}

.unity-tab__header {
    font-size: var(--text-big);
    height: 64px;
    width: 200px;
    background-color: rgb(34, 38, 42);
    color: rgb(245, 245, 245);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 4px;
    margin-left: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    flex-direction: row;
    justify-content: center;
}

.unity-tab__header:hover {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.unity-tab__header:checked {
    background-color: rgb(0, 88, 176);
}

.unity-tab__header:checked:hover {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgb(0, 82, 163);
}

#header > #key-prompt-container {
    position: absolute;
    width: 720px;
    height: 96px;
    align-self: center;
    flex-direction: row;
    justify-content: space-between;
}

#header .key-prompt {
    align-self: center;
    height: 48px;
    width: 48px;
}

#header #key-prompt-prev {
    background-image: var(--icon-key-q);
}

#header #key-prompt-next {
    background-image: var(--icon-key-e);
}
