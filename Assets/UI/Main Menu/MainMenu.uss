#main-menu {
    flex-grow: 1;
    width: 33%;
    justify-content: center;
    color: rgb(250, 250, 250);
    background-color: rgba(0, 0, 0, 0.45);
    align-self: center;
}

#header {
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    font-size: var(--text-huge);
    color: rgb(94, 125, 79);
    flex-grow: 2;
    align-items: center;
    justify-content: flex-end;
}

#body {
    font-size: var(--text-big);
    flex-grow: 4;
    justify-content: center;
    align-items: center;
}

#body > .unity-button {
    height: 12%;
    width: 50%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 8px;
    padding-left: 0;
    margin-top: 8px;
    margin-bottom: 8px;
}

#bg {
    position: absolute;
    right: 0%;
    bottom: 0%;
    left: 0%;
    top: 0%;
    filter: blur(10);
    background-image: url("project://database/Assets/Art/Sprites/Backgrounds/Plains/0.png?fileID=2800000&guid=e1db1b7b91e559f47820945915ffdd89&type=3#0");
    background-color: rgba(0, 0, 0, 0.525);
}
