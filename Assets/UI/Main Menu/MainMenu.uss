:root {
    --game-title-font-size: 112px;
}

#bg {
    position: absolute;
    right: 0%;
    bottom: 0%;
    left: 0%;
    top: 0%;
    filter: blur(10);
    background-image: url("project://database/Assets/Art/Sprites/Backgrounds/Plains/0.png?fileID=2800000&guid=e1db1b7b91e559f47820945915ffdd89&type=3#0");
    background-color: rgba(0, 0, 0, 0.525);
}

#main-menu {
    flex-grow: 1;
    width: 33%;
    justify-content: center;
    color: rgb(250, 250, 250);
    background-image: url("project://database/Assets/UI/Sprites/Kenney_Fantasy_UI.png?fileID=796471921&guid=20b9f77168ce29b48936f877b6046690&type=3#ui-panel-01-full");
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.898);
    align-self: center;
    padding-left: 9px;
    padding-right: 9px;
}

#main-menu #header {
    flex-grow: 2;
    align-items: center;
    justify-content: flex-end;
}

#header #title {
    align-self: stretch;
    justify-content: space-around;
    flex-direction: row;
}

#header #title-text {
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    font-size: var(--game-title-font-size);
    color: rgb(94, 125, 79);
    margin-top: 0;
    margin-right: 20px;
    margin-bottom: 0;
    margin-left: 20px;
}

#header.title-wing {
    background-image: url("project://database/Assets/UI/Sprites/Kenney_Fantasy_UI.png?fileID=-1660820721&guid=20b9f77168ce29b48936f877b6046690&type=3#ui-divider-05-faded");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat repeat;
    flex-grow: 1;
    height: 56px;
    align-self: center;
    visibility: hidden;
}

#header #wing-right {
    scale: -1 1;
}

#main-menu #body {
    font-size: var(--text-big);
    flex-grow: 4;
    justify-content: center;
    align-items: center;
}

#body > .unity-button {
    height: 12%;
    width: 50%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 8px;
    padding-left: 0;
    margin-top: 8px;
    margin-bottom: 8px;
}
