{
    "explorer.excludeGitIgnore": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "README.md": "CHANGELOG.md, LICENSE.md, ATTRIBUTIONS.md",
        ".editorconfig": "*.DotSettings",
        "*": "${capture}.meta",
        "manifest.json": "packages-lock.json",
        "ProjectSettings.asset": "AudioManager.asset, InputManager.asset, MemorySettings.asset, TagManager.asset, TimeManager.asset, NavMeshAreas.asset, ClusterInputManager.asset, XRSettings.asset",
        "GraphicsSettings.asset": "QualitySettings.asset, VFXManager.asset, ShaderGraphSettings.asset, URPProjectSettings.asset",
        "DynamicsManager.asset": "Physics2DSettings.asset, PhysicsCoreProjectSettings2D.asset",
        "EditorSettings.asset": "EditorBuildSettings.asset, PresetManager.asset, ProjectAuditorSettings.asset, SceneTemplateSettings.json, UIToolkitProjectSettings.asset, VersionControlSettings.asset, UnityConnectSettings.asset",
        "PackageManagerSettings.asset": "TimelineSettings.asset, BehaviorSettings.asset, EntitiesClientSettings.asset, NetCode*.asset, MultiplayerManager.asset, NetworkManager.asset",
        "CommonBurstAotSettings.json": "BurstAotSettings_*.json",
    },
    "files.exclude": {
        "Assets/Plugins/": false,
        "Assets/TextMesh Pro/": true,
        "UIElementsSchema/": true,
    },
    "files.readonlyInclude": {
        "**/*.meta": false,
        "Packages/packages-lock.json": true,
        "UIElementsSchema/**": true,
        "Assets/Plugins/": true,
        "Assets/TextMesh Pro/": true,
        "FMODProject/**": false,
    },
    "conventionalCommitBuilder.template": "<type><scope>: <description>",
    "conventionalCommitBuilder.autoCommit": true,
    "conventionalCommitBuilder.showCommit": true,
    "conventionalCommitBuilder.customTypes": [
        {
            "label": "perf",
            "description": "Performance improvement",
            "detail": "A code change that improves performance"
        },
        {
            "label": "ci",
            "description": "CI",
            "detail": "Changes to CI configuration files and scripts (e.g. GitHub Actions)"
        },
        {
            "label": "balance",
            "description": "Balancing changes",
            "detail": "Changes to the balancing of difficulty, economy, levels, etc."
        }
    ],
    "conventionalCommitBuilder.scopes": [
        "ai",
        "art",
        "audio",
        "combat",
        "content",
        "core",
        "economy",
        "fmod",
        "gameplay",
        "graphics",
        "juice",
        "level",
        "narrative",
        "shader",
        "system",
        "tool",
        "ui",
        "vfx",
        "weather"
    ],
    "commitlint.config.extend.rules": {
        "subject-case": [
            2,
            "never",
            [
                "sentence-case",
                "start-case",
                "pascal-case",
                "upper-case"
            ]
        ],
        "type-empty": [
            2,
            "never"
        ]
    },
    "cSpell.files": [
        "Assets/**/*.cs"
    ],
    "cSpell.dictionaries": [
        "game-development",
        "gaming-terms",
        "unity"
    ],
    "cSpell.customDictionaries": {
        "tulip-words": {
            "name": "Tulip",
            "path": "${workspaceRoot}/.vscode/dictionaries/tulip.dic",
            "addWords": true
        },
        "unity-words": {
            "name": "Unity Engine",
            "path": "${workspaceRoot}/.vscode/dictionaries/unity.dic",
            "addWords": true
        },
        "gaming-words": {
            "name": "Gaming",
            "path": "${workspaceRoot}/.vscode/dictionaries/gaming.dic",
            "addWords": true
        }
    },
}
